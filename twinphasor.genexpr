Param g1_rate(0.6, min=0.1, max=18);
Param g1_shape(0, min=0, max=1);
Param g1_src(0, min=0, max=1);
Param g2_rate(3.5, min=0.1, max=18);
Param g2_shape(0, min=0, max=1);
Param a_on(1, min=0, max=1);
Param a_depth(0.8, min=0, max=1);
Param a_fb(0.35, min=0, max=1);
Param a_sweep(0, min=0, max=2);
Param b_on(0, min=0, max=1);
Param b_depth(0.8, min=0, max=1);
Param b_fb(0.35, min=0, max=1);
Param b_sweep(0, min=0, max=3);
Param b_sync(0, min=0, max=2);
Param b_input(1, min=0, max=2);
Param pedal(0.5, min=0, max=1);
Param mixamt(0.5, min=0, max=1);
Param fullwet(0, min=0, max=1);
Param outmode(1, min=0, max=3);
Param insum(1, min=0, max=1);
Param drive(0, min=-24, max=24);
Param outgain(0, min=-24, max=12);
Param route(0, min=0, max=2);
Param vintage(1, min=0, max=1);
Param q_lag_p(1, min=0, max=1);
Param q_mis_p(1, min=0, max=1);
Param q_law_p(1, min=0, max=1);
Param q_rng_p(1, min=0, max=1);
Param q_clip_p(1, min=0, max=1);
Param q_noise_p(1, min=0, max=1);
Param q_hum_p(0, min=0, max=1);
Param hum_hz(0, min=0, max=1);
Param q_fade_p(1, min=0, max=1);
Param q_lfo_p(1, min=0, max=1);
Param q_bw_p(1, min=0, max=1);
Param mod_lo(150, min=20, max=2000);
Param mod_hi(9000, min=500, max=18000);
Param env_amt(0.5, min=0, max=1);
Param env_att(10, min=1, max=100);
Param env_rel(250, min=20, max=2000);
Param env_pol(0, min=0, max=1);

History ph1(0);
History ph2(0);
History ped_s(0);
History mix_s(0);
History da_s(0);
History db_s(0);
History fa_s(0);
History fb_s(0);
History drv_s(0);
History og_s(0);
History lsa(0);
History lsb(0);
History envf(0);
History eamt_s(0);
History hp_xa(0);
History hp_ya(0);
History hp_xb(0);
History hp_yb(0);
History humph(0);
History fb6_a(0);
History fb6_b(0);
History fhx_a(0);
History fhy_a(0);
History fhx_b(0);
History fhy_b(0);
History fbl_a(0);
History fbl_b(0);
History bp_a(0);
History bp_b(0);
History wV(1);
History wbw(1);
History wcl(1);
History wr0(1);
History wr1(0);
History wr2(0);
History wo0(0);
History wo1(1);
History wo2(0);
History wo3(0);
History wi0(0);
History wi1(1);
History wi2(0);
History wV1(1);
History wbw1(1);
History wcl1(1);
History wr0a(1);
History wr1a(0);
History wr2a(0);
History wo0a(0);
History wo1a(1);
History wo2a(0);
History wo3a(0);
History wi0a(0);
History wi1a(1);
History wi2a(0);
History g_a0(0.3);
History x1_a0(0);
History y1_a0(0);
History g_a1(0.3);
History x1_a1(0);
History y1_a1(0);
History g_a2(0.3);
History x1_a2(0);
History y1_a2(0);
History g_a3(0.3);
History x1_a3(0);
History y1_a3(0);
History g_a4(0.3);
History x1_a4(0);
History y1_a4(0);
History g_a5(0.3);
History x1_a5(0);
History y1_a5(0);
History g_b0(0.3);
History x1_b0(0);
History y1_b0(0);
History g_b1(0.3);
History x1_b1(0);
History y1_b1(0);
History g_b2(0.3);
History x1_b2(0);
History y1_b2(0);
History g_b3(0.3);
History x1_b3(0);
History y1_b3(0);
History g_b4(0.3);
History x1_b4(0);
History y1_b4(0);
History g_b5(0.3);
History x1_b5(0);
History y1_b5(0);

sr = samplerate;
V = vintage > 0.5;
q_lag = V && (q_lag_p > 0.5);
q_mis = V && (q_mis_p > 0.5);
q_law = V && (q_law_p > 0.5);
q_rng = V && (q_rng_p > 0.5);
q_clip = V && (q_clip_p > 0.5);
q_noise = V && (q_noise_p > 0.5);
q_hum = V && (q_hum_p > 0.5);
q_fade = V && (q_fade_p > 0.5);
q_lfo = V && (q_lfo_p > 0.5);
q_bw = V && (q_bw_p > 0.5);
qv_lag = q_lag_p > 0.5;
qv_mis = q_mis_p > 0.5;
qv_law = q_law_p > 0.5;
qv_rng = q_rng_p > 0.5;
eff_a0 = 1.1268;
eff_a1 = 0.8224;
rm_a0 = 0.8939;
tk_a0 = 1.2140;
rm_a1 = 1.0751;
tk_a1 = 0.9358;
rm_a2 = 0.9501;
tk_a2 = 1.0376;
rm_a3 = 1.0085;
tk_a3 = 1.2199;
rm_a4 = 1.1165;
tk_a4 = 1.2027;
rm_a5 = 1.0731;
tk_a5 = 0.8604;
eff_b0 = 1.0490;
eff_b1 = 0.9246;
rm_b0 = 1.0472;
tk_b0 = 0.8936;
rm_b1 = 0.9204;
tk_b1 = 1.0028;
rm_b2 = 1.1138;
tk_b2 = 1.1334;
rm_b3 = 1.0934;
tk_b3 = 0.7513;
rm_b4 = 0.9417;
tk_b4 = 1.0499;
rm_b5 = 0.9884;
tk_b5 = 1.0686;
c_sm  = 1 - exp(-twopi * 15 / sr);
c_on  = 1 - exp(-1 / (0.004 * sr));
c_fb  = 1 - exp(-twopi * 18000 / sr);
c_bon = 1 - exp(-1 / (0.010 * sr));
c_boff= 1 - exp(-1 / (0.150 * sr));
c_fast= 1 - exp(-1 / (0.006 * sr));
c_sw  = 1 - exp(-1 / (0.003 * sr));
c_ls  = 1 - exp(-1 / (0.003 * sr));
c_hp  = exp(-twopi * 8.7 / sr);
c_fhp = exp(-twopi * 34 / sr);
mix_t = (fullwet > 0.5) ? 1 : mixamt;
ped_s = ped_s + (pedal - ped_s) * c_sm;
mix_s = mix_s + (mix_t - mix_s) * c_sm;
da_s = da_s + (a_depth - da_s) * c_sm;
db_s = db_s + (b_depth - db_s) * c_sm;
fa_s = fa_s + (a_fb - fa_s) * c_sm;
fb_s = fb_s + (b_fb - fb_s) * c_sm;
drv_s = drv_s + (dbtoa(drive) - drv_s) * c_sm;
og_s = og_s + (dbtoa(outgain) - og_s) * c_sm;
mlo = min(mod_lo, mod_hi * 0.9); mhi = mod_hi;
wV1 = fixdenorm(wV1 + (V - wV1) * c_sw); wV = fixdenorm(wV + (wV1 - wV) * c_sw);
wbw1 = fixdenorm(wbw1 + (q_bw - wbw1) * c_sw); wbw = fixdenorm(wbw + (wbw1 - wbw) * c_sw);
wcl1 = fixdenorm(wcl1 + (q_clip - wcl1) * c_sw); wcl = fixdenorm(wcl + (wcl1 - wcl) * c_sw);
wr0a = fixdenorm(wr0a + ((abs(route - 0) < 0.5) - wr0a) * c_sw); wr0 = fixdenorm(wr0 + (wr0a - wr0) * c_sw);
wi0a = fixdenorm(wi0a + ((abs(b_input - 0) < 0.5) - wi0a) * c_sw); wi0 = fixdenorm(wi0 + (wi0a - wi0) * c_sw);
wr1a = fixdenorm(wr1a + ((abs(route - 1) < 0.5) - wr1a) * c_sw); wr1 = fixdenorm(wr1 + (wr1a - wr1) * c_sw);
wi1a = fixdenorm(wi1a + ((abs(b_input - 1) < 0.5) - wi1a) * c_sw); wi1 = fixdenorm(wi1 + (wi1a - wi1) * c_sw);
wr2a = fixdenorm(wr2a + ((abs(route - 2) < 0.5) - wr2a) * c_sw); wr2 = fixdenorm(wr2 + (wr2a - wr2) * c_sw);
wi2a = fixdenorm(wi2a + ((abs(b_input - 2) < 0.5) - wi2a) * c_sw); wi2 = fixdenorm(wi2 + (wi2a - wi2) * c_sw);
wo0a = fixdenorm(wo0a + ((abs(outmode - 0) < 0.5) - wo0a) * c_sw); wo0 = fixdenorm(wo0 + (wo0a - wo0) * c_sw);
wo1a = fixdenorm(wo1a + ((abs(outmode - 1) < 0.5) - wo1a) * c_sw); wo1 = fixdenorm(wo1 + (wo1a - wo1) * c_sw);
wo2a = fixdenorm(wo2a + ((abs(outmode - 2) < 0.5) - wo2a) * c_sw); wo2 = fixdenorm(wo2 + (wo2a - wo2) * c_sw);
wo3a = fixdenorm(wo3a + ((abs(outmode - 3) < 0.5) - wo3a) * c_sw); wo3 = fixdenorm(wo3 + (wo3a - wo3) * c_sw);
r1 = (g1_src > 0.5) ? (0.1 * pow(180, ped_s)) : g1_rate;
ph1 = wrap(ph1 + r1 / sr, 0, 1);
tri1 = 1 - 4 * abs(ph1 - 0.5);
sn1 = q_lfo ? (1.5 * tri1 - 0.5 * tri1 * tri1 * tri1) : sin(halfpi * tri1);
lfo1 = (g1_shape > 0.5) ? ((ph1 < 0.5) ? -1 : 1) : sn1;
ph2 = wrap(ph2 + g2_rate / sr, 0, 1);
tri2 = 1 - 4 * abs(ph2 - 0.5);
sn2 = q_lfo ? (1.5 * tri2 - 0.5 * tri2 * tri2 * tri2) : sin(halfpi * tri2);
lfo2 = (g2_shape > 0.5) ? ((ph2 < 0.5) ? -1 : 1) : sn2;
ph1q = wrap(ph1 + 0.25, 0, 1);
tri1q = 1 - 4 * abs(ph1q - 0.5);
sn1q = q_lfo ? (1.5 * tri1q - 0.5 * tri1q * tri1q * tri1q) : sin(halfpi * tri1q);
lfo1q = (g1_shape > 0.5) ? ((ph1q < 0.5) ? -1 : 1) : sn1q;
det = max(abs(in1), abs(in2));
ca = 1 - exp(-1 / (env_att * 0.001 * sr)); cr = 1 - exp(-1 / (env_rel * 0.001 * sr));
envf = fixdenorm(envf + (det - envf) * ((det > envf) ? ca : cr));
eamt_s = eamt_s + (env_amt - eamt_s) * c_sm;
ev = clamp(4 * eamt_s * sqrt(envf), 0, 1);
se = (env_pol > 0.5) ? (1 - 2 * ev) : (2 * ev - 1);
pv = 2 * ped_s - 1;
sA = (a_sweep < 0.5) ? lfo1 : ((a_sweep < 1.5) ? pv : se);
g1b = (b_sync > 1.5) ? lfo1q : lfo1;
sB = (b_sweep < 0.5) ? g1b : ((b_sweep < 1.5) ? lfo2 : ((b_sweep < 2.5) ? pv : se));
sB = (abs(b_sync - 1) < 0.5) ? -sB : sB;
lt_a = clamp(0.5 + 0.5 * sA * da_s, 0, 1);
lt_b = clamp(0.5 + 0.5 * sB * db_s, 0, 1);
lsa = fixdenorm(lsa + (lt_a - lsa) * c_ls); ls_a = lsa;
lsb = fixdenorm(lsb + (lt_b - lsb) * c_ls); ls_b = lsb;
G_a = fa_s * 0.862; G_b = fb_s * 0.862;
vs = 2 * drv_s;
inA = ((insum > 0.5) ? 0.5 * (in1 + in2) : in1) * vs;
inB = in2 * vs;
hA = fixdenorm(c_hp * (hp_ya + inA - hp_xa)); hp_xa = inA; hp_ya = hA;
hB = fixdenorm(c_hp * (hp_yb + inB - hp_xb)); hp_xb = inB; hp_yb = hB;
x_a = inA + wbw * (hA - inA);
// ===== PHASOR A =====
I_a = qv_law ? (0.004 + 0.996*ls_a) : (0.004*pow(250, ls_a));
fm_a = mlo * pow(mhi / mlo, ls_a);
gt_a = pow(I_a, 0.85);
gsum_a = 0;
tg = gt_a * (qv_mis ? eff_a0 : 1);
g = g_a0;
toff = clamp(0.020 / sqrt(max(g, 0.004)), 0.02, 0.35) * (qv_mis ? tk_a0 : 1);
cc = (tg > g) ? c_on : (1 - exp(-1 / (toff * sr)));
g = qv_lag ? (g + (tg - g) * cc) : tg;
g_a0 = g;
gsum_a = gsum_a + g;
R = 3300 * (qv_mis ? rm_a0 : 1) / max(g, 0.0001);
R = qv_rng ? (R * 220000 / (R + 220000)) : R;
fv = 1 / (twopi * R * 6.8e-9);
fc = fm_a * pow(max(fv, 1) / fm_a, wV);
fc = clamp(fc, 10, sr * 0.45);
t = tan(pi * fc / sr);
k_a0 = (t - 1) / (t + 1);
tg = gt_a * (qv_mis ? eff_a0 : 1);
g = g_a1;
toff = clamp(0.020 / sqrt(max(g, 0.004)), 0.02, 0.35) * (qv_mis ? tk_a1 : 1);
cc = (tg > g) ? c_on : (1 - exp(-1 / (toff * sr)));
g = qv_lag ? (g + (tg - g) * cc) : tg;
g_a1 = g;
gsum_a = gsum_a + g;
R = 3300 * (qv_mis ? rm_a1 : 1) / max(g, 0.0001);
R = qv_rng ? (R * 220000 / (R + 220000)) : R;
fv = 1 / (twopi * R * 6.8e-9);
fc = fm_a * pow(max(fv, 1) / fm_a, wV);
fc = clamp(fc, 10, sr * 0.45);
t = tan(pi * fc / sr);
k_a1 = (t - 1) / (t + 1);
tg = gt_a * (qv_mis ? eff_a0 : 1);
g = g_a2;
toff = clamp(0.020 / sqrt(max(g, 0.004)), 0.02, 0.35) * (qv_mis ? tk_a2 : 1);
cc = (tg > g) ? c_on : (1 - exp(-1 / (toff * sr)));
g = qv_lag ? (g + (tg - g) * cc) : tg;
g_a2 = g;
gsum_a = gsum_a + g;
R = 3300 * (qv_mis ? rm_a2 : 1) / max(g, 0.0001);
R = qv_rng ? (R * 220000 / (R + 220000)) : R;
fv = 1 / (twopi * R * 6.8e-9);
fc = fm_a * pow(max(fv, 1) / fm_a, wV);
fc = clamp(fc, 10, sr * 0.45);
t = tan(pi * fc / sr);
k_a2 = (t - 1) / (t + 1);
tg = gt_a * (qv_mis ? eff_a1 : 1);
g = g_a3;
toff = clamp(0.020 / sqrt(max(g, 0.004)), 0.02, 0.35) * (qv_mis ? tk_a3 : 1);
cc = (tg > g) ? c_on : (1 - exp(-1 / (toff * sr)));
g = qv_lag ? (g + (tg - g) * cc) : tg;
g_a3 = g;
gsum_a = gsum_a + g;
R = 3300 * (qv_mis ? rm_a3 : 1) / max(g, 0.0001);
R = qv_rng ? (R * 220000 / (R + 220000)) : R;
fv = 1 / (twopi * R * 6.8e-9);
fc = fm_a * pow(max(fv, 1) / fm_a, wV);
fc = clamp(fc, 10, sr * 0.45);
t = tan(pi * fc / sr);
k_a3 = (t - 1) / (t + 1);
tg = gt_a * (qv_mis ? eff_a1 : 1);
g = g_a4;
toff = clamp(0.020 / sqrt(max(g, 0.004)), 0.02, 0.35) * (qv_mis ? tk_a4 : 1);
cc = (tg > g) ? c_on : (1 - exp(-1 / (toff * sr)));
g = qv_lag ? (g + (tg - g) * cc) : tg;
g_a4 = g;
gsum_a = gsum_a + g;
R = 3300 * (qv_mis ? rm_a4 : 1) / max(g, 0.0001);
R = qv_rng ? (R * 220000 / (R + 220000)) : R;
fv = 1 / (twopi * R * 6.8e-9);
fc = fm_a * pow(max(fv, 1) / fm_a, wV);
fc = clamp(fc, 10, sr * 0.45);
t = tan(pi * fc / sr);
k_a4 = (t - 1) / (t + 1);
tg = gt_a * (qv_mis ? eff_a1 : 1);
g = g_a5;
toff = clamp(0.020 / sqrt(max(g, 0.004)), 0.02, 0.35) * (qv_mis ? tk_a5 : 1);
cc = (tg > g) ? c_on : (1 - exp(-1 / (toff * sr)));
g = qv_lag ? (g + (tg - g) * cc) : tg;
g_a5 = g;
gsum_a = gsum_a + g;
R = 3300 * (qv_mis ? rm_a5 : 1) / max(g, 0.0001);
R = qv_rng ? (R * 220000 / (R + 220000)) : R;
fv = 1 / (twopi * R * 6.8e-9);
fc = fm_a * pow(max(fv, 1) / fm_a, wV);
fc = clamp(fc, 10, sr * 0.45);
t = tan(pi * fc / sr);
k_a5 = (t - 1) / (t + 1);
fhp_a = fixdenorm(c_fhp * (fhy_a + fb6_a - fhx_a)); fhx_a = fb6_a; fhy_a = fhp_a;
fbl_a = fixdenorm(fbl_a + (fhp_a - fbl_a) * c_fb);
fbin_a = fhp_a + wbw * (fbl_a - fhp_a);
u = -x_a + G_a * fbin_a + (q_noise ? noise() * 1.7e-4 : 0);
u = u + wcl * (13.5 * tanh(u / 13.5) - u);
y = fixdenorm(k_a0 * u + x1_a0 - k_a0 * y1_a0);
x1_a0 = u; y1_a0 = y; u = y;
y = fixdenorm(k_a1 * u + x1_a1 - k_a1 * y1_a1);
x1_a1 = u; y1_a1 = y; u = y;
y = fixdenorm(k_a2 * u + x1_a2 - k_a2 * y1_a2);
x1_a2 = u; y1_a2 = y; u = y;
y = fixdenorm(k_a3 * u + x1_a3 - k_a3 * y1_a3);
x1_a3 = u; y1_a3 = y; u = y;
y = fixdenorm(k_a4 * u + x1_a4 - k_a4 * y1_a4);
x1_a4 = u; y1_a4 = y; u = y;
y = fixdenorm(k_a5 * u + x1_a5 - k_a5 * y1_a5);
x1_a5 = u; y1_a5 = y; u = y;
fb6_a = u;
wet_a = -(u + wcl * (13.5 * tanh(u / 13.5) - u));
bt = a_on;
cb = q_fade ? ((bt > bp_a) ? c_bon : c_boff) : c_fast;
bp_a = fixdenorm(bp_a + (bt - bp_a) * cb);
mm = mix_s;
o_a = x_a * (1 - mm * bp_a) + wet_a * mm * bp_a;
led_a = (wV * pow(gsum_a / 6, 1.1765) + (1 - wV) * ls_a) * bp_a;
srcB = inB + wbw * (hB - inB);
x_b = wi0 * x_a + wi1 * o_a + wi2 * srcB;
// ===== PHASOR B =====
I_b = qv_law ? (0.004 + 0.996*ls_b) : (0.004*pow(250, ls_b));
fm_b = mlo * pow(mhi / mlo, ls_b);
gt_b = pow(I_b, 0.85);
gsum_b = 0;
tg = gt_b * (qv_mis ? eff_b0 : 1);
g = g_b0;
toff = clamp(0.020 / sqrt(max(g, 0.004)), 0.02, 0.35) * (qv_mis ? tk_b0 : 1);
cc = (tg > g) ? c_on : (1 - exp(-1 / (toff * sr)));
g = qv_lag ? (g + (tg - g) * cc) : tg;
g_b0 = g;
gsum_b = gsum_b + g;
R = 3300 * (qv_mis ? rm_b0 : 1) / max(g, 0.0001);
R = qv_rng ? (R * 220000 / (R + 220000)) : R;
fv = 1 / (twopi * R * 6.8e-9);
fc = fm_b * pow(max(fv, 1) / fm_b, wV);
fc = clamp(fc, 10, sr * 0.45);
t = tan(pi * fc / sr);
k_b0 = (t - 1) / (t + 1);
tg = gt_b * (qv_mis ? eff_b0 : 1);
g = g_b1;
toff = clamp(0.020 / sqrt(max(g, 0.004)), 0.02, 0.35) * (qv_mis ? tk_b1 : 1);
cc = (tg > g) ? c_on : (1 - exp(-1 / (toff * sr)));
g = qv_lag ? (g + (tg - g) * cc) : tg;
g_b1 = g;
gsum_b = gsum_b + g;
R = 3300 * (qv_mis ? rm_b1 : 1) / max(g, 0.0001);
R = qv_rng ? (R * 220000 / (R + 220000)) : R;
fv = 1 / (twopi * R * 6.8e-9);
fc = fm_b * pow(max(fv, 1) / fm_b, wV);
fc = clamp(fc, 10, sr * 0.45);
t = tan(pi * fc / sr);
k_b1 = (t - 1) / (t + 1);
tg = gt_b * (qv_mis ? eff_b0 : 1);
g = g_b2;
toff = clamp(0.020 / sqrt(max(g, 0.004)), 0.02, 0.35) * (qv_mis ? tk_b2 : 1);
cc = (tg > g) ? c_on : (1 - exp(-1 / (toff * sr)));
g = qv_lag ? (g + (tg - g) * cc) : tg;
g_b2 = g;
gsum_b = gsum_b + g;
R = 3300 * (qv_mis ? rm_b2 : 1) / max(g, 0.0001);
R = qv_rng ? (R * 220000 / (R + 220000)) : R;
fv = 1 / (twopi * R * 6.8e-9);
fc = fm_b * pow(max(fv, 1) / fm_b, wV);
fc = clamp(fc, 10, sr * 0.45);
t = tan(pi * fc / sr);
k_b2 = (t - 1) / (t + 1);
tg = gt_b * (qv_mis ? eff_b1 : 1);
g = g_b3;
toff = clamp(0.020 / sqrt(max(g, 0.004)), 0.02, 0.35) * (qv_mis ? tk_b3 : 1);
cc = (tg > g) ? c_on : (1 - exp(-1 / (toff * sr)));
g = qv_lag ? (g + (tg - g) * cc) : tg;
